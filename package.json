{
  "name": "pam-report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:api": "node scripts/check-pam.mjs",
    "check:report": "node scripts/check-executive-report.mjs",
    "check:items": "node scripts/check-item-apis.mjs",
    "refresh:report": "node scripts/refresh-resource-report.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
